  "service": {
    "routes": [
      {
        "method": "GET",
        "path": "/api/ecommerce/check",
        "query": {
          "url": "Product page URL, required",
          "expectedPrice": "Optional number for price-drop alerting",
          "currency": "Optional currency override"
        }
      },
      {
        "method": "POST",
        "path": "/api/ecommerce/batch",
        "body": {
          "items": [{ "url": "string", "expectedPrice": "number optional", "currency": "string optional" }],
          "limit": "10 product URLs per request"
        }
      }
    ],
    "responseFields": ["title", "price", "currency", "inStock", "availability", "seller", "rating", "reviewCount", "sku", "asin", "gtin", "image", "canonicalUrl", "signals"],
    "whyMobileProxy": "Amazon and large retailers aggressively degrade or block datacenter IPs. Real 4G/5G mobile IPs improve access to localized product pages, live stock status, mobile-only prices, and anti-bot-protected product metadata."
  }
