# ─── YOUR WALLET (where USDC payments arrive) ───
# Solana wallet (REQUIRED unless you set a Base wallet). The agent refuses to
# start with no wallet, and NEVER falls back to anyone else's address — your
# revenue can only go to what you set here.
WALLET_ADDRESS=
# Base wallet (OPTIONAL). Set to also accept USDC on Base. When unset, Base is
# simply not offered (no fallback).
WALLET_ADDRESS_BASE=

# ─── PROXY CREDENTIALS (your metered mobile egress) ───
# Get from https://client.proxies.sx or buy account-lessly via x402:
#   curl "https://api.proxies.sx/v1/x402/pool?tier=peer&country=us&traffic=1"
PROXY_HOST=
PROXY_HTTP_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_COUNTRY=US
# Or a rotating pool (semicolon-delimited host:port:user:pass:country):
# PROXY_LIST=

# ─── SERVER ───
PORT=3000
RATE_LIMIT=60

# ─── REPLAY / RECEIPT STORE (durable payment ledger) ───
# SQLite file (default). Survives restarts so a spent tx stays spent.
REPLAY_STORE_PATH=./data/payments.sqlite
# For multi-replica deploys, front it with a shared store (see docs/payments.md).

# ─── DEV ONLY ───
# Skip on-chain verification to rehearse the 402->pay->200 loop without real
# USDC. The server REFUSES to start with this set when NODE_ENV=production.
# SKIP_PAYMENT_VERIFICATION=1

# ─── OPTIONAL: custom RPC ───
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BASE_RPC_URL=https://mainnet.base.org
